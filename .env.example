# OpenAI-compatible chat settings for every lab.
# Copy this file to .env and edit it. Never commit .env.
#
# Shell variables win over this file. Do not export a real API key
# into a shared shell history if you can keep it in .env instead.

# --- Ollama (default, local) ---
# Install: https://ollama.com/download
# Then: ollama pull llama3.2
BASE_URL=http://localhost:11434/v1
API_KEY=ollama
MODEL=llama3.2

# --- Groq (hosted). Comment out the Ollama lines above before using. ---
# Pick a model with *local* tool-call support. groq/compound runs tools
# on Groq's servers and cannot call this lab's read_file.
# BASE_URL=https://api.groq.com/openai/v1
# API_KEY=gsk_paste_your_key_here
# MODEL=llama-3.3-70b-versatile

# --- OpenRouter (hosted). Comment out the other providers first. ---
# Model ids look like vendor/name. Use one whose model page lists tools.
# BASE_URL=https://openrouter.ai/api/v1
# API_KEY=sk-or-paste_your_key_here
# MODEL=meta-llama/llama-3.3-70b-instruct
